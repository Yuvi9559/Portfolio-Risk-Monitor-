# ── Copy this to .env and fill in values ──────────────────────
# Never commit .env to Git

# App
APP_NAME="Portfolio Risk Monitor"
DEBUG=false

# Database (override for cloud deployment)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/portfoliodb
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/portfoliodb

# Redis
REDIS_URL=redis://redis:6379/0

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# Risk Engine
LOOKBACK_DAYS=252
RISK_FREE_RATE=0.05
BENCHMARK_TICKER=SPY

# Price refresh
PRICE_REFRESH_INTERVAL=60
PRICE_CACHE_TTL=55
