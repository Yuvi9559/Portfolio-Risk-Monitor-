# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Portfolio Risk Monitor Pro"
APP_VERSION="1.0.0"
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (plain postgresql://, NOT asyncpg – the app converts it)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_risk

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Resend (transactional email) ───────────────────────────────────────────────
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Risk engine ───────────────────────────────────────────────────────────────
LOOKBACK_DAYS=252
RISK_FREE_RATE=0.05
